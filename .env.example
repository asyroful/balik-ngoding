# PostgreSQL — kredensial database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=balik_ngoding

# Backend — koneksi ke database (gunakan "db" sebagai hostname karena itu nama service Docker)
DATABASE_URL=postgres://postgres:postgres@db:5432/balik_ngoding?sslmode=disable

# Backend — port yang digunakan Go/Gin server
PORT=8080

# Backend — origin frontend untuk konfigurasi CORS
FRONTEND_ORIGIN=http://localhost:3000

# Frontend — URL backend API yang diakses dari browser
NEXT_PUBLIC_API_URL=http://localhost:8080
